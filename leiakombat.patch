diff --git a/leiakombat.html b/leiakombat.html
new file mode 100644
index 0000000..5414167
--- /dev/null
+++ b/leiakombat.html
@@ -0,0 +1,353 @@
+<!DOCTYPE html>
+<html lang="es">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,viewport-fit=cover,user-scalable=no">
+<meta name="theme-color" content="#0f0f11">
+<meta name="mobile-web-app-capable" content="yes">
+<meta name="apple-mobile-web-app-capable" content="yes">
+<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
+<meta name="description" content="LeiaKOMBAT: el juego de peleas de LeiaNET. Elegí escenario, peleá contra la CPU, con un amigo o probá el online (beta).">
+<title>LeiaKOMBAT · LeiaNET</title>
+<link rel="icon" href="assets/favicon-32.png">
+<link rel="stylesheet" href="assets/kombat/kombat2.css">
+<link rel="stylesheet" href="assets/kombat/tutorial.css">
+<link rel="preload" as="font" type="font/ttf" href="assets/fonts/Silkscreen-Regular.ttf" crossorigin>
+<link rel="preload" as="font" type="font/ttf" href="assets/fonts/PixelifySans-Medium.ttf" crossorigin>
+<link rel="preload" as="image" href="assets/kombat/idle.webp">
+</head>
+<body>
+<div id="app">
+  <div id="stage"><canvas id="c" aria-label="Escenario de pelea"></canvas></div>
+
+  <header id="top">
+    <a id="back" href="mantenimiento.html" aria-label="Volver a LeiaNET"><span class="px" data-i="left"></span><span class="bt">LeiaNET</span></a>
+    <div class="grow"></div>
+    <div class="ibs">
+      <button class="ib" id="bFull" aria-label="Pantalla completa" title="Pantalla completa" hidden><span class="px" data-i="expand"></span></button>
+      <button class="ib" id="bMute" aria-label="Sonido" title="Sonido (M)"><span class="px" data-i="sound"></span></button>
+      <button class="ib" id="bPause" aria-label="Pausa" title="Pausa (P)" hidden><span class="px" data-i="pause"></span></button>
+    </div>
+  </header>
+
+  <!-- ===== controles táctiles ===== -->
+  <div id="touch" aria-hidden="true">
