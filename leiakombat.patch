+@keyframes stamp{from{opacity:0;transform:rotate(-8deg) scale(2.6)}to{opacity:1;transform:rotate(-8deg) scale(1)}}
+.stats td{vertical-align:middle}.stats td .v{display:block}
+.stats td .bar{display:block;height:4px;margin:3px auto 0;width:100%;max-width:90px;background:rgba(255,255,255,.14);border-radius:3px;overflow:hidden}
+.stats td .bar i{display:block;height:100%;width:var(--w);background:#8b8c95;transform-origin:left;animation:barg .7s .35s cubic-bezier(.2,.8,.2,1) both}
+.stats td.lead .v{color:var(--amber)}.stats td.lead .bar i{background:var(--amber)}
+@keyframes barg{from{transform:scaleX(0)}}
+.rtip{margin:10px 0 0;font:500 13px var(--fm);color:var(--dim);text-align:center;line-height:1.4}
+#rAgain kbd{margin-left:8px}
