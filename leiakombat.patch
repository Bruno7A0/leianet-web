diff --git a/assets/kombat/kombat.css b/assets/kombat/kombat.css
new file mode 100644
index 0000000..0ff5612
--- /dev/null
+++ b/assets/kombat/kombat.css
@@ -0,0 +1,197 @@
+/* LeiaKOMBAT · estilos (identidad LeiaNET: vidrio, plata y ámbar) · fuentes pixel: Silkscreen + Pixelify Sans (OFL) */
+@font-face{font-family:'Silkscreen';font-weight:100 900;font-display:swap;src:url(../fonts/Silkscreen-Regular.ttf) format('truetype')}
+@font-face{font-family:'Pixelify Sans';font-weight:100 900;font-display:swap;src:url(../fonts/PixelifySans-Medium.ttf) format('truetype')}
+:root{color-scheme:dark;--bg:#0b0b0e;--elev:#18181b;--elev2:#222227;--bd:#2b2b30;--fg:#ededee;--dim:#a9aaaf;--mute:#706f74;--ac:#c7c7cc;--amber:#d9a441;--ok:#6bbf7b;--bad:#ff6b7a;
+--fd:'Silkscreen','Pixelify Sans',monospace;--fb:'Pixelify Sans',monospace;--fm:'Pixelify Sans',monospace;
+--glass:linear-gradient(155deg,rgba(255,255,255,.09),rgba(255,255,255,.015) 55%,rgba(255,255,255,.03));--gb:rgba(255,255,255,.15);--gbh:rgba(255,255,255,.32);
+--sh:0 24px 60px -28px rgba(0,0,0,.7),inset 0 1px 0 rgba(255,255,255,.09);--sl:max(10px,env(safe-area-inset-left));--sr:max(10px,env(safe-area-inset-right));--sb:max(8px,env(safe-area-inset-bottom))}
+*{box-sizing:border-box}
+html,body{margin:0;height:100%;background:var(--bg);color:var(--fg);font:16px/1.4 var(--fb);overflow:hidden;overscroll-behavior:none;-webkit-font-smoothing:antialiased;-webkit-tap-highlight-color:transparent;user-select:none;-webkit-user-select:none}
+#app{position:fixed;inset:0;background:radial-gradient(1000px 520px at 20% -10%,rgba(217,164,65,.07),transparent 60%),#07070a}
+#stage{position:absolute;inset:0;display:flex;align-items:center;justify-content:center}
+#c{display:block;width:min(100vw,calc(100vh*1280/600));height:min(100vh,calc(100vw*600/1280));background:#05060f;touch-action:none;box-shadow:0 0 0 1px rgba(255,255,255,.05)}
+@supports (height:100dvh){#c{width:min(100vw,calc(100dvh*1280/600));height:min(100dvh,calc(100vw*600/1280))}}
+button,input,select{font:inherit;color:inherit}
+:focus-visible{outline:2px solid var(--amber);outline-offset:3px;border-radius:8px}
+
+#top{position:absolute;top:0;left:0;right:0;display:flex;align-items:center;gap:8px;padding:max(8px,env(safe-area-inset-top)) var(--sr) 0 var(--sl);z-index:5;pointer-events:none}
+#top>*{pointer-events:auto}.grow{flex:1;pointer-events:none!important}
+#back{font:600 12px var(--fm);letter-spacing:.06em;color:var(--dim);text-decoration:none;padding:6px 10px;border-radius:9px;background:rgba(10,10,14,.55);border:1px solid var(--gb);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px)}
+#back:hover{color:#fff;border-color:var(--gbh)}
+.ib{width:36px;height:36px;border-radius:10px;border:1px solid var(--gb);background:rgba(10,10,14,.55);cursor:pointer;font-size:14px;backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px)}
+.ib:hover{border-color:var(--gbh)}.ib[hidden]{display:none}
+body.playing #back{opacity:.35}
+
+.screen{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:44px 12px 12px;z-index:4;background:radial-gradient(ellipse at 30% 15%,rgba(217,164,65,.07),rgba(6,6,9,.78) 70%);backdrop-filter:blur(5px);-webkit-backdrop-filter:blur(5px);animation:fade .25s ease both;overflow:auto}
+.screen.clear{background:rgba(5,5,8,.35);backdrop-filter:none;-webkit-backdrop-filter:none}
+.screen[hidden]{display:none}
+@keyframes fade{from{opacity:0}to{opacity:1}}
+@keyframes rise{from{opacity:0;transform:translateY(10px) scale(.985)}to{opacity:1;transform:none}}
+.card{position:relative;width:min(380px,100%);max-height:100%;overflow:auto;background:var(--glass),rgba(22,22,26,.86);border:1px solid var(--gb);border-radius:18px;box-shadow:var(--sh);padding:22px 22px 18px;animation:rise .3s cubic-bezier(.2,.8,.2,1) both;margin:auto}
+.card.wide{width:min(760px,100%)}
+.card::after{content:'';position:absolute;left:12%;right:12%;top:0;height:1px;background:linear-gradient(90deg,transparent,rgba(255,255,255,.4),transparent);pointer-events:none}
+.menu{text-align:center}
+.logo{display:block;width:min(210px,62%);height:auto;margin:0 auto 6px;opacity:.92}
+h1,h2{font-family:var(--fd);margin:0;letter-spacing:.02em}
+h1{font-size:30px;line-height:1;font-weight:600;color:#e9e9ee}h1 b{font-weight:700;background:linear-gradient(100deg,#d9a441 10%,#fff 50%,#d9a441 90%);background-size:220% auto;-webkit-background-clip:text;background-clip:text;color:transparent;animation:shine 5s linear infinite}
+@keyframes shine{to{background-position:-220% center}}
+h2{font-size:24px;font-weight:700;margin-bottom:8px}
+.sub{font:600 11px var(--fm);letter-spacing:.14em;text-transform:uppercase;color:var(--dim);margin:8px 0 18px}
+.stack{display:flex;flex-direction:column;gap:9px}
+.two{display:flex;gap:9px}.two>*{flex:1;padding-left:6px;padding-right:6px}
+.row{display:flex;gap:9px;margin-top:12px;flex-wrap:wrap;align-items:center}.row.end{justify-content:flex-end}.row>input{flex:1;min-width:120px}
+.btn{position:relative;overflow:hidden;font:700 13px var(--fd);letter-spacing:.05em;text-transform:uppercase;padding:12px 16px;border-radius:12px;cursor:pointer;color:var(--fg);background:var(--glass),var(--elev);border:1px solid var(--gb);box-shadow:inset 0 1px 0 rgba(255,255,255,.08);transition:transform .12s,border-color .15s,background-color .15s}
+.btn::after{content:'';position:absolute;top:0;left:-60%;width:40%;height:100%;background:linear-gradient(115deg,transparent,rgba(255,255,255,.16),transparent);transform:skewX(-18deg);transition:left .55s ease;pointer-events:none}
+.btn:hover{border-color:var(--gbh);background-color:var(--elev2)}.btn:hover::after{left:120%}
+.btn:active{transform:translateY(1px) scale(.985)}
+.btn:disabled{opacity:.45;cursor:default;transform:none}
+.btn.p{background:linear-gradient(155deg,#fff,#c7c7cc 60%);color:#111113;border-color:rgba(255,255,255,.5);box-shadow:0 14px 34px -14px rgba(199,199,204,.55),inset 0 1px 0 rgba(255,255,255,.6)}
+.btn.p:hover{background:linear-gradient(155deg,#fff,#e2e2e6 60%)}
+.btn small{font:500 10.5px var(--fm);letter-spacing:.05em;text-transform:none;opacity:.6;margin-left:6px}
+.beta{font:700 9.5px var(--fm)!important;letter-spacing:.08em;text-transform:uppercase;color:#111!important;background:var(--amber);border-radius:5px;padding:2px 6px;opacity:1!important;vertical-align:middle}
+.foot{font:500 11px var(--fm);color:var(--mute);margin:14px 0 0}
+.lbl{font:600 11px var(--fm);letter-spacing:.08em;text-transform:uppercase;color:var(--dim);margin:12px 0 6px}.lbl span{color:var(--amber)}
+.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:0 16px}
+input:not([type=range]),select{width:100%;background:rgba(0,0,0,.28);border:1px solid var(--gb);border-radius:10px;padding:9px 11px;outline:none}
+input:focus,select:focus{border-color:var(--amber)}
+select option{background:#18181b}
+input[type=range]{width:100%;accent-color:var(--amber);height:28px}
+.seg{display:flex;background:rgba(0,0,0,.28);border:1px solid var(--gb);border-radius:10px;padding:3px;gap:3px}
+.seg button{flex:1;border:0;background:transparent;border-radius:7px;padding:7px 4px;font:700 12px var(--fd);letter-spacing:.04em;text-transform:uppercase;color:var(--dim);cursor:pointer}
+.seg button:hover{color:#fff}.seg button.on{background:linear-gradient(155deg,#fff,#c7c7cc);color:#111}
+.stages{display:grid;grid-template-columns:repeat(4,1fr);gap:9px}
+.stg{position:relative;aspect-ratio:16/10;border-radius:11px;border:2px solid transparent;overflow:hidden;cursor:pointer;padding:0;background:#000;color:#fff;text-align:left}
+.stg canvas{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
+.stg span{position:absolute;left:0;right:0;bottom:0;padding:14px 8px 6px;font:700 11px var(--fd);letter-spacing:.04em;background:linear-gradient(0deg,rgba(0,0,0,.85),transparent)}
+.stg:hover{border-color:var(--gbh)}.stg.on{border-color:var(--amber);box-shadow:0 0 0 3px rgba(217,164,65,.25)}
+.keys{width:100%;border-collapse:collapse;font-size:13px}
+.keys th{font:600 11px var(--fm);letter-spacing:.08em;text-transform:uppercase;color:var(--dim);text-align:left;padding:6px 8px}
+.keys td{padding:7px 8px;border-top:1px solid #2b2b30;color:var(--dim)}.keys td:first-child{color:var(--fg)}
+.stats td:nth-child(n+2){font:700 15px var(--fd);color:#fff}.stats th:nth-child(n+2),.stats td:nth-child(n+2){text-align:center}
+kbd{font:600 11px var(--fm);background:linear-gradient(155deg,#fff,#c7c7cc);color:#111;border-radius:5px;padding:2px 6px}
+.note{color:var(--dim);font-size:12.5px;margin:12px 0 0}code{font-family:var(--fm);color:var(--amber);font-size:12px}
+.st{font:600 11px var(--fm);letter-spacing:.1em;text-transform:uppercase;color:var(--dim);margin:0 0 8px}.st::before{content:'';display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--mute);margin-right:8px}.st.on::before{background:var(--ok);box-shadow:0 0 0 3px rgba(107,191,123,.18)}
+.err{color:var(--bad);font:500 12.5px var(--fm);margin:0 0 6px;min-height:0}.err:empty{display:none}
+.rooms{max-height:30vh;overflow:auto;margin:8px 0}
+.slot{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:9px 12px;margin:6px 0;border-radius:12px;background:rgba(0,0,0,.2);border:1px solid #2b2b30}
+.slot b{font-family:var(--fd)}.slot small{display:block;font:500 11px var(--fm);color:var(--mute)}.slot.me{border-color:var(--gbh)}.slot.off{opacity:.5}.slot em{font:700 11px var(--fm);font-style:normal;color:var(--ok);letter-spacing:.06em;white-space:nowrap}
+.slot .btn{padding:7px 12px;font-size:12px}
+.chat{height:84px;overflow:auto;background:rgba(0,0,0,.25);border:1px solid #2b2b30;border-radius:10px;padding:6px 9px;margin:10px 0 0;font:500 12px var(--fm);color:var(--dim);user-select:text}.chat b{color:var(--amber)}
+.res{text-align:center}.res h2{font-size:42px;margin:0}.res .sub{margin-bottom:12px}
