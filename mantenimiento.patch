+<!DOCTYPE html>
+<html lang="es">
+<head>
+<meta charset="UTF-8">
+<meta http-equiv="Content-Security-Policy" content="object-src 'none'; base-uri 'self'; form-action 'self'">
+<meta name="viewport" content="width=device-width, initial-scale=1.0">
+<title>Estamos en mantenimiento - LeiaNET</title>
+<meta name="robots" content="noindex, follow">
+<meta name="theme-color" content="#0f0f11">
+<link rel="icon" type="image/png" sizes="32x32" href="assets/favicon-32.png">
+<link rel="icon" type="image/png" sizes="16x16" href="assets/favicon-16.png">
+<link rel="apple-touch-icon" sizes="180x180" href="assets/favicon-180.png">
+<link rel="stylesheet" href="assets/mantenimiento.css">
+<script src="assets/mantenimiento.js" defer></script>
+</head>
+<body>
+<main class="mnt-in">
+  <div class="mnt-tag">LeiaNET</div>
+  <img class="mnt-dog" src="assets/leia-run_v2.webp" alt="" width="480" height="251" aria-hidden="true">
+  <h1>Estamos en mantenimiento</h1>
+  <p class="mnt-sub">Por mientras, podés jugar a estos juegos</p>
+  <div class="mnt-games">
+    <div class="mnt-game">
+      <div class="mnt-kind">Endless runner</div>
+      <h2 class="mnt-name">LeiaRUN</h2>
+      <p class="mnt-desc">Un Border Collie esquiva obstáculos espaciales. Salto con espacio, click o tap.</p>
+      <button type="button" class="mnt-btn" id="mnt-play-run" data-assets="assets/">Jugar LeiaRUN</button>
+    </div>
+    <div class="mnt-game">
+      <div class="mnt-kind">Sandbox 3D</div>
+      <h2 class="mnt-name">THE NETWORK</h2>
+      <p class="mnt-desc">Un juego tipo Minecraft en el navegador, edición LeiaNET.</p>
+      <a class="mnt-btn" href="leiamc/index.html">Jugar THE NETWORK</a>
+    </div>
+    <div class="mnt-game">
+      <div class="mnt-kind">Multijugador</div>
+      <h2 class="mnt-name">Fútbol 3D</h2>
+      <p class="mnt-desc">Fútbol en 3D con salas online. Armá partido con amigos o entrá a uno ya empezado.</p>
+      <a class="mnt-btn" href="futbol.html">Jugar Fútbol 3D</a>
+    </div>
+  </div>
+</main>
+</body>
+</html>
